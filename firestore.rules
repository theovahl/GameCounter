rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Benutzerprofile und Freundeslisten
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Doppelkopf-Gruppen
    match /doppelkopf_groups/{groupId} {
      allow read, write: if request.auth != null;
    }

    // Doppelkopf-Spiele (inklusive Runden & Punktestände)
    match /doppelkopf_games/{gameId} {
      allow read, write: if request.auth != null;
    }

    // Mario Kart Gruppen
    match /mariokart_groups/{groupId} {
      allow read, write: if request.auth != null;
    }

    // Mario Kart Spiele (inklusive Grand Prix Rennen, Platzierungen & Punkte)
    match /mariokart_games/{gameId} {
      allow read, write: if request.auth != null;
    }
  }
}

